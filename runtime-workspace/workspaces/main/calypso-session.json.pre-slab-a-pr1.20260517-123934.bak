    },
    {
      "id": "melodyT",
      "kind": "expr",
      "mvoice": "bass",
      "source": "on bass2 (tintinnabuli aMinT above1 mPart)",
      "tvoice": "bass2"
    },
    {
      "id": "fugue1",
      "kind": "expr",
      "mvoice": "fugue",
      "source": "on bass1 (fugueVoice defaultVoice subject)",
      "tvoice": "bass1"
    },
    {
      "id": "fugue2",
      "kind": "expr",
      "mvoice": "fugue",
      "source": "on bass2 (fugueVoice (defaultVoice { transpose = 7 }) subject)",
      "tvoice": "bass2"
    },
    {
      "id": "fugue3",
      "kind": "expr",
      "mvoice": "fugue",
      "source": "on bass3 (fugueVoice (defaultVoice { transpose = 7, speed = doubleSpeed }) subject)",
      "tvoice": "bass3"
    },
    {
      "id": "fugue4",
      "kind": "expr",
      "mvoice": "fugue",
      "source": "on bass4 (fugueVoice (defaultVoice { transpose = -3, retrograde = true, speed = halfSpeed }) subject)",
      "tvoice": "bass4"
    },
    {
      "id": "c2",
      "kind": "expr",
      "source": "set-scale d-dorian"
    },
    {
      "id": "c3",
      "kind": "expr",
      "source": "set-scale aHarmonicMinor"
    },
